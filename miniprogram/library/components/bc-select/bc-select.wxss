.bc-select__face { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--bc-surface); border: 2rpx solid var(--bc-border); color: var(--bc-text); font-weight: 700; }
.bc-select__chevron { color: var(--bc-muted); }
.is-disabled { opacity: 0.45; }
