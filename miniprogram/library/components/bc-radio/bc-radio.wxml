<view
  class="bc-radio {{checked ? 'is-checked' : ''}} {{disabled ? 'is-disabled' : ''}}"
  style="--bc-text: {{theme.textPrimary}}; --bc-border: {{theme.borderDefault}}; --bc-surface: {{theme.surfaceRaised}}; --bc-brand: {{theme.brandPrimary}};"
  bindtap="onTap"
>
  <view class="bc-radio__dot"></view>
  <text wx:if="{{text}}" class="bc-radio__label">{{text}}</text>
</view>
