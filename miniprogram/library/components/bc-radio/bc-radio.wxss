.bc-radio {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}
.bc-radio__dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid var(--bc-border);
  background: var(--bc-surface);
  box-sizing: border-box;
  position: relative;
}
.bc-radio.is-checked .bc-radio__dot {
  border-color: var(--bc-brand);
}
.bc-radio.is-checked .bc-radio__dot::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 50%;
  background: var(--bc-brand);
}
.bc-radio__label {
  color: var(--bc-text);
  font-size: 28rpx;
  font-weight: 700;
}
.is-disabled { opacity: 0.45; }
