.bc-upload {
  padding: 20rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--bc-border);
  background: var(--bc-surface);
  box-sizing: border-box;
}
.bc-upload__trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--bc-brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.bc-upload__empty {
  margin-top: 16rpx;
  color: var(--bc-muted);
  font-size: 26rpx;
}
.bc-upload__list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.bc-upload__item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: var(--bc-subtle);
}
.bc-upload__name {
  flex: 1;
  color: var(--bc-text);
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bc-upload__remove {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--bc-muted);
}
.is-disabled { opacity: 0.45; }
