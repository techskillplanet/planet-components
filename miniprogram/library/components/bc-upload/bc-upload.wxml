<view
  class="bc-upload {{disabled ? 'is-disabled' : ''}}"
  style="--bc-text: {{theme.textPrimary}}; --bc-muted: {{theme.textTertiary}}; --bc-border: {{theme.borderDefault}}; --bc-surface: {{theme.surfaceRaised}}; --bc-subtle: {{theme.surfaceSubtle}}; --bc-brand: {{theme.brandPrimary}};"
>
  <view class="bc-upload__trigger" bindtap="onPick">选择文件</view>
  <view wx:if="{{!files || files.length === 0}}" class="bc-upload__empty">尚未选择文件</view>
  <view wx:else class="bc-upload__list">
    <view
      wx:for="{{files}}"
      wx:key="id"
      class="bc-upload__item"
      data-id="{{item.id || index}}"
    >
      <text class="bc-upload__name">{{item.name || item}}</text>
      <view class="bc-upload__remove" data-id="{{item.id || index}}" catchtap="onRemove">×</view>
    </view>
  </view>
</view>
