.bc-drawer {
  position: fixed;
  inset: 0;
  z-index: 1000;
}
.bc-drawer__mask {
  position: absolute;
  inset: 0;
  background: rgba(23, 58, 98, 0.28);
}
.bc-drawer__panel {
  position: absolute;
  left: 0;
  right: 0;
  max-height: 72%;
  background: var(--bc-surface);
  border: 2rpx solid var(--bc-border);
  padding: 28rpx;
  box-sizing: border-box;
}
.bc-drawer--bottom .bc-drawer__panel {
  bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
}
.bc-drawer--top .bc-drawer__panel {
  top: 0;
  border-radius: 0 0 32rpx 32rpx;
}
.bc-drawer__header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.bc-drawer__title {
  flex: 1;
  color: var(--bc-text);
  font-size: 34rpx;
  font-weight: 900;
}
.bc-drawer__close {
  color: var(--bc-muted);
  font-size: 40rpx;
  padding: 0 8rpx;
}
.bc-drawer__body { color: var(--bc-text); }
