<view
  class="bc-collapse bc-collapse--{{variant}} {{expanded ? 'is-expanded' : ''}} {{disabled ? 'is-disabled' : ''}}"
  style="--bc-text: {{theme.textPrimary}}; --bc-muted: {{theme.textSecondary}}; --bc-border: {{theme.borderDefault}}; --bc-surface: {{theme.surfaceRaised}}; --bc-brand: {{theme.brandPrimary}};"
>
  <view class="bc-collapse__header" bindtap="onToggle">
    <text class="bc-collapse__title">{{title}}</text>
    <view class="bc-collapse__mark">{{expanded ? '−' : '+'}}</view>
  </view>
  <view wx:if="{{expanded}}" class="bc-collapse__body">{{message}}</view>
</view>
