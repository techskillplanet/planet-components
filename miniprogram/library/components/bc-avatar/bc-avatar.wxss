.bc-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--bc-surface);
  color: var(--bc-text);
  font-weight: 800;
  box-sizing: border-box;
}
.bc-avatar--sm { width: 64rpx; height: 64rpx; font-size: 22rpx; }
.bc-avatar--md { width: 80rpx; height: 80rpx; font-size: 28rpx; }
.bc-avatar--lg { width: 112rpx; height: 112rpx; font-size: 36rpx; }
.bc-avatar--primary { background: var(--bc-brand); color: var(--bc-inverse); }
.bc-avatar--subtle { background: var(--bc-subtle); color: var(--bc-brand); }
.bc-avatar__img { width: 100%; height: 100%; }
.bc-avatar__text { line-height: 1; }
