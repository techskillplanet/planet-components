<view
  class="bc-btn bc-btn--{{variant}} {{disabled || loading ? 'is-disabled' : ''}} {{loading ? 'is-loading' : ''}} {{pressed ? 'is-pressed' : ''}}"
  style="--bc-brand: {{theme.brandPrimary}}; --bc-brand-dark: {{theme.brandDark}}; --bc-text: {{theme.textPrimary}}; --bc-surface: {{theme.surfaceRaised}}; --bc-border: {{theme.borderDefault}}; --bc-danger: {{theme.danger}};"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchEnd"
  bindtap="onTap"
>
  <view class="bc-btn__shadow"></view>
  <view class="bc-btn__face">
    <view wx:if="{{loading}}" class="bc-btn__spinner" aria-hidden="true"></view>
    <text>{{text}}</text>
  </view>
</view>
