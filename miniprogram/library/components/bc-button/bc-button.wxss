.bc-btn {
  position: relative;
  display: block;
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
}

.bc-btn__shadow,
.bc-btn__face {
  border-radius: 999rpx;
}

.bc-btn__shadow {
  position: absolute;
  left: 0;
  right: 0;
  top: 10rpx;
  bottom: 0;
  background: var(--bc-border);
}

.bc-btn__face {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: transform 120ms ease;
}

.bc-btn--default .bc-btn__face {
  background: var(--bc-surface);
  color: var(--bc-text);
  border: 2rpx solid var(--bc-border);
}

.bc-btn--primary .bc-btn__face {
  background: var(--bc-brand);
  color: #fff;
}

.bc-btn--danger .bc-btn__face {
  background: var(--bc-danger);
  color: #fff;
}

.bc-btn--text .bc-btn__face,
.bc-btn--link .bc-btn__face {
  background: transparent;
  color: var(--bc-brand);
  border: none;
}

.bc-btn.is-pressed .bc-btn__face {
  transform: translateY(8rpx);
}

.bc-btn.is-disabled {
  opacity: 0.5;
}

.bc-btn.is-loading {
  pointer-events: none;
}

.bc-btn__spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: bc-btn-spin 0.7s linear infinite;
  flex-shrink: 0;
}

.bc-btn--default .bc-btn__spinner,
.bc-btn--text .bc-btn__spinner,
.bc-btn--link .bc-btn__spinner {
  border-color: rgba(23, 58, 98, 0.25);
  border-top-color: currentColor;
}

@keyframes bc-btn-spin {
  to {
    transform: rotate(360deg);
  }
}
