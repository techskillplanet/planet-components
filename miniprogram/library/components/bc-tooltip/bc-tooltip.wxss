.bc-tooltip {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}
.bc-tooltip__trigger { display: inline-flex; }
.bc-tooltip__bubble {
  position: absolute;
  z-index: 20;
  max-width: 420rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--bc-surface);
  color: var(--bc-inverse);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  pointer-events: none;
}
.bc-tooltip--top .bc-tooltip__bubble {
  bottom: calc(100% + 12rpx);
  left: 50%;
  transform: translateX(-50%);
}
.bc-tooltip--bottom .bc-tooltip__bubble {
  top: calc(100% + 12rpx);
  left: 50%;
  transform: translateX(-50%);
}
.bc-tooltip--left .bc-tooltip__bubble {
  right: calc(100% + 12rpx);
  top: 50%;
  transform: translateY(-50%);
}
.bc-tooltip--right .bc-tooltip__bubble {
  left: calc(100% + 12rpx);
  top: 50%;
  transform: translateY(-50%);
}
