<view
  class="bc-tooltip bc-tooltip--{{placement}} {{(visible != null ? visible : open) ? 'is-open' : ''}}"
  style="--bc-text: {{theme.textPrimary}}; --bc-surface: {{theme.brandDark || theme.brandPrimary}}; --bc-inverse: #fff;"
  bindtap="onTap"
>
  <view class="bc-tooltip__trigger">
    <slot></slot>
  </view>
  <view wx:if="{{visible != null ? visible : open}}" class="bc-tooltip__bubble" role="tooltip">{{text}}</view>
</view>
