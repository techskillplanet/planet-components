/* Page-level theme classes — distinct for sky / night / mint / sunrise. */
.theme-sky {
  --bc-page-start: #DDF4FF;
  --bc-page-end: #F9FDFF;
  --bc-text-primary: #173A62;
  --bc-text-secondary: #365D82;
  --bc-text-tertiary: #7895AE;
  --bc-surface: #FFFFFF;
  --bc-surface-subtle: #F6FBFF;
  --bc-border: #C8EAFF;
  --bc-brand-primary: #31A8FF;
  --bc-brand-dark: #1479D6;
  --bc-brand-subtle: #E5F6FF;
  --bc-success: #2BB8E6;
  --bc-success-subtle: #E8F7FC;
  --bc-warning: #FFD166;
  --bc-selected-fill: #E5F6FF;
  --bc-selected-border: #31A8FF;
  --bc-emphasis-fill: #F6FBFF;
  --bc-active-fill: #FFF7D7;
  --bc-danger: #FF6B7A;
}

