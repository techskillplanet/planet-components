# Template for android/gradle.properties (tracked with real values in this repo).
# Fallback: ~/.gradle/gradle.properties
#
# Maven groupId: io.github.techskillplanet (verify namespace on Sonatype Central Portal)
#
# Controllable publish (Gradle staging + Portal upload):
#   android/scripts/publish-maven-central.sh
#   android/scripts/publish-maven-central.sh --dry-run
#   android/scripts/publish-maven-central.sh --list
#   android/scripts/publish-maven-central.sh --upload-only
#
# Then open https://central.sonatype.com/publishing/deployments and Publish.

# --- Sonatype Central Portal (https://central.sonatype.com → Account → Generate User Token)
ossrhUsername=YOUR_SONATYPE_TOKEN_USERNAME
ossrhPassword=YOUR_SONATYPE_TOKEN_PASSWORD

# --- GPG signing (pick ONE approach)

# Option A: local GPG keyring (gpg --full-generate-key)
# signing.keyId=ABCD1234
# signing.password=YOUR_GPG_PASSPHRASE
# signing.secretKeyRingFile=/Users/YOU/.gnupg/secring.gpg

# Option B: armored private key file (works without local gpg binary)
# signing.keyId=ABCD1234
# signing.password=YOUR_GPG_PASSPHRASE
# signingKeyFile=/Users/YOU/.gnupg/planet-components-signing.asc
